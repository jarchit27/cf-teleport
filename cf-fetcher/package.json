{
  "name": "cf-teleport",
  "displayName": "CF Teleport",
  "description": "CF Teleport",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cf-teleport.codeNow",
        "title": "Codeforces: Code Now (Trigger CPH)",
        "enablement": "false"
      }
    ],
    "customEditors": [
      {
        "viewType": "cf-teleport.cfPreview",
        "displayName": "Codeforces Problem Preview",
        "selector": [
          {
            "filenamePattern": "*.cf"
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "cheerio": "^1.2.0",
    "highlight.js": "^11.11.1",
    "markdown-it": "^15.0.0"
  }
}
